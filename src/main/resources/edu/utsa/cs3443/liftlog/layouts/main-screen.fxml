<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #121416;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.liftlog.Controller.MainScreenController">
   <left>
      <VBox prefHeight="750.0" prefWidth="200.0" style="-fx-background-color: #242424;" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10" left="10" right="10"/>
         </padding>
         <children>
            <Label text="Lift Log" textFill="WHITE">
               <VBox.margin>
                  <Insets top="20" left="10" right="20" bottom="10"/>
               </VBox.margin>
               <font>
                  <Font name="Inter Regular" size="32.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                     <Image url="@../images/Logo.png" />
                  </ImageView>
               </graphic>
            </Label>
            <Button fx:id="HomeButton" prefHeight="15" prefWidth="140" style="-fx-background-color: #333333;-fx-background-radius: 5;" mnemonicParsing="false" text="Home" textFill="#b3b3b3" alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets top="5" bottom="5"/>
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="15" fitWidth="15">
                   <Image url="@../images/HomeLogo.png"/>
                  </ImageView>
            </graphic>
            </Button>
            <Button fx:id="AddWorkoutButton" prefHeight="15" prefWidth="140" style="-fx-background-color: #333333;-fx-background-radius: 5;" mnemonicParsing="false" text="Add Workout" textFill="#b3b3b3" alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets top="5" bottom="5"/>
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="15" fitWidth="15">
                     <Image url="@../images/AddWorkoutLogo.png"/>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="HistoryButton" prefHeight="15" prefWidth="140" style="-fx-background-color: #333333;-fx-background-radius: 5;" mnemonicParsing="false" text="Workout History" textFill="b3b3b3" alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets top="5" bottom="5"/>
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="15" fitWidth="15">
                     <Image url="@../images/HistoryLogo.png"/>
                  </ImageView>
               </graphic>
            </Button>
            <Button fx:id="SettingsButton" prefHeight="15" prefWidth="140" style="-fx-background-color: #333333;-fx-background-radius: 5;" mnemonicParsing="false" text="Settings" textFill="#b3b3b3" alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets top="5" bottom="5"/>
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="15" fitWidth="15">
                     <Image url="@../images/SettingsLogo.png"/>
                  </ImageView>
               </graphic>
            </Button>
         </children></VBox>
   </left>
</BorderPane>
