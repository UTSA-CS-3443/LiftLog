<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.liftlog.Controller.HomeController">
   <children>
      <VBox prefHeight="750.0" prefWidth="900.0" style="-fx-background-color: #121416;">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="94.0" prefWidth="900.0">
               <children>
                  <Label prefHeight="45.0" prefWidth="165.0" text="Welcome!" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="757.0">
                     <children>
                        <Label fx:id="date" text="Date" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <VBox prefHeight="657.0" prefWidth="900.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="900.0">
                     <children>
                        <Label alignment="BOTTOM_LEFT" prefHeight="45.0" prefWidth="165.0" text="Recent Workouts" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="15.0" />
                           </HBox.margin>
                        </Label>
                        <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="722.0">
                           <children>
                              <AnchorPane prefHeight="200.0" prefWidth="200.0">
                                 <children>
                                    <Button fx:id="viewAllButton" alignment="TOP_LEFT" layoutX="100.0" layoutY="14.0" mnemonicParsing="false" onAction="#onViewAllClick" text="View All">
                                       <font>
                                          <Font size="18.0" />
                                       </font>
                                    </Button>
                                 </children>
                              </AnchorPane>
                           </children>
                           <HBox.margin>
                              <Insets right="15.0" />
                           </HBox.margin>
                        </HBox>
                     </children>
                  </HBox>
                  <VBox fx:id="recentWorkoutsBox" prefWidth="870.0" spacing="12.0">
                     <VBox.margin>
                        <Insets bottom="15.0" left="15.0" right="15.0" />
                     </VBox.margin>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
