<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="TOP_LEFT" minHeight="115.0" prefWidth="820.0" spacing="18.0" style="-fx-background-color: #242729; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.liftlog.Controller.WorkoutCardController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
    </padding>
    <children>
        <StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="80.0" prefWidth="80.0" scaleZ="0.0" style="-fx-background-color: #123D2A; -fx-background-radius: 30;">
         <children>
            <Label text="" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="29.0" />
               </font>
            </Label>
            <ImageView fitHeight="56.0" fitWidth="54.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Logo.png" />
               </image>
            </ImageView>
         </children>
        </StackPane>
        <VBox maxWidth="Infinity" prefHeight="79.0" prefWidth="612.0" spacing="9.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="workoutName" text="Push Day" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox fx:id="exerciseList" spacing="5.0" />
            </children>
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin>
        </VBox>
        <Label fx:id="workoutDate" text="Date" textFill="#b8b8b8">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
    </children>
</HBox>
